    "%@ · %lld saved %@" : {
      "comment" : "A subheadline label showing the level of the destination and the number of saved items. The first argument is the localized name of the destination's level. The second argument is the count of saved items. The third argument is a pluralization suffix based on the count of saved items.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld saved %3$@"
          }
        }
      }
    },
